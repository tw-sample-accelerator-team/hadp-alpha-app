{
  "name": "api",
  "description": "A backend service",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "check": "bun run typecheck && bun run lint && bun run test:unit",
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --preload ./test/support/database.preload.ts",
    "test:e2e": "bun test test/e2e --preload ./test/support/database.preload.ts --timeout 20000",
    "test:coverage": "bun test test/unit --coverage",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
